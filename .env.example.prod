APP_ENV=production

STORAGE=r2

PYPAH_DATA_ROOT=/tmp

R2_ACCESS_KEY_ID=...

R2_SECRET_ACCESS_KEY=...

R2_ENDPOINT=...

R2_BUCKET=...

API_URL=http://pypah-api:8000

# Controla se a API le o dataset completo ou uma amostra reduzida.
# Em producao/demo, mantenha em true para manter a API leve.
USE_SAMPLE=true

# Numero de linhas da amostra usada quando USE_SAMPLE=true. A amostra e
# gerada pelo pipeline (nao pela API), de forma estratificada por Ano/Mes,
# e salva como consolidated_sample_<SAMPLE_ROWS>.parquet. Mudar este valor
# so tem efeito na proxima execucao do pipeline.
SAMPLE_ROWS=10000

GROQ_API_KEY=...